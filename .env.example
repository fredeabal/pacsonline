# Copia este archivo a .env y cambia las credenciales antes de iniciar
APP_PORT=8080
CI_ENVIRONMENT=production

# Credenciales internas de Orthanc (no exponer 8042 fuera de Docker)
ORTHANC_NAME=PACS_ONLINE
ORTHANC_AET=PACSONLINE
ORTHANC_DICOM_PORT=4242
ORTHANC_USER=orthanc_admin
ORTHANC_PASSWORD=cambia_esta_clave_segura

# Base de datos PostgreSQL para el índice de Orthanc y el portal web (en BDs separadas)
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=cambia_esta_clave_pg
APP_DB_DRIVER=Postgre
APP_DB_NAME=pacs_app
