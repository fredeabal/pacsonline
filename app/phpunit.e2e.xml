<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests_e2e/bootstrap.php"
    backupGlobals="false"
    beStrictAboutOutputDuringTests="true"
    colors="true"
    columns="max"
    failOnRisky="true"
    failOnWarning="true"
    cacheDirectory="build/.phpunit.e2e.cache"
>
    <testsuites>
        <testsuite name="Infra">
            <directory>./tests_e2e/Infra</directory>
        </testsuite>
        <testsuite name="Tier1">
            <directory>./tests_e2e/Tier1</directory>
        </testsuite>
        <testsuite name="Tier2">
            <directory>./tests_e2e/Tier2</directory>
        </testsuite>
        <testsuite name="Tier3">
            <directory>./tests_e2e/Tier3</directory>
        </testsuite>
        <testsuite name="Tier4">
            <directory>./tests_e2e/Tier4</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <directory suffix=".php">./app/Views</directory>
            <file>./app/Config/Routes.php</file>
        </exclude>
    </source>

    <php>
        <server name="app.baseURL" value="http://example.com/"/>
        <server name="CODEIGNITER_SCREAM_DEPRECATIONS" value="0"/>
        <const name="HOMEPATH" value="./"/>
        <const name="CONFIGPATH" value="./app/Config/"/>
        <const name="PUBLICPATH" value="./public/"/>
    </php>
</phpunit>
